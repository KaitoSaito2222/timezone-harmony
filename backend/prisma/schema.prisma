generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../ERD.md"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

model User {
  id              String            @id @default(uuid())
  supabaseId      String            @unique @map("supabase_id") @db.VarChar(255)
  email           String            @unique @db.VarChar(255)
  displayName     String?           @map("display_name") @db.VarChar(100)
  role            UserRole          @default(user)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  timezonePresets TimezonePreset[]
  meetingPolls    MeetingPoll[]

  @@map("users")
}

model TimezonePreset {
  id          String                @id @default(uuid())
  userId      String                @map("user_id")
  name        String                @db.VarChar(100)
  description String?               @db.Text
  isFavorite  Boolean               @default(false) @map("is_favorite")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       TimezonePresetItem[]

  @@index([userId])
  @@map("timezone_presets")
}

model TimezonePresetItem {
  id                 String         @id @default(uuid())
  presetId           String         @map("preset_id")
  timezoneIdentifier String         @map("timezone_identifier") @db.VarChar(100)
  displayLabel       String?        @map("display_label") @db.VarChar(200)
  position           Int            @default(0)
  startTime          DateTime?      @map("start_time")
  endTime            DateTime?      @map("end_time")
  createdAt          DateTime       @default(now()) @map("created_at")
  preset             TimezonePreset @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@index([presetId])
  @@map("timezone_preset_items")
}


// Keep-alive table to prevent Supabase from auto-pausing the project.
// Read with the anon key by .github/workflows/supabase-keepalive.yml.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}

// Shareable meeting polls. The poll id (uuid) acts as the link secret, so
// polls are readable/votable without an account.
model MeetingPoll {
  id              String       @id @default(uuid())
  title           String       @db.VarChar(120)
  timezones       String[]
  durationMinutes Int          @default(60) @map("duration_minutes")
  createdAt       DateTime     @default(now()) @map("created_at")
  expiresAt       DateTime     @map("expires_at")
  // Null for polls created anonymously (and not yet claimed by a signed-in user).
  userId          String?      @map("user_id")
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  options         PollOption[]

  @@index([userId])
  @@map("meeting_polls")
}

model PollOption {
  id       String      @id @default(uuid())
  pollId   String      @map("poll_id")
  startsAt DateTime    @map("starts_at")
  position Int         @default(0)
  poll     MeetingPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String     @id @default(uuid())
  optionId  String     @map("option_id")
  voterName String     @map("voter_name") @db.VarChar(50)
  createdAt DateTime   @default(now()) @map("created_at")
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, voterName])
  @@index([optionId])
  @@map("poll_votes")
}
