# ============================================================
# Next.js Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Database (server-only; used by the API route handlers in src/app/api)
# Local: the Docker PostgreSQL from docker-compose.yml
# Production: Supabase transaction pooler (port 6543) for DATABASE_URL,
#             session pooler or direct connection (port 5432) for DIRECT_DATABASE_URL (migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/timezone_harmony"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/timezone_harmony"
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres"
# DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Configuration
# NEXT_PUBLIC_SUPABASE_URL is also used server-side to verify access tokens (JWKS).
# Get these from: https://app.supabase.com/project/YOUR-PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Site URL (used for OAuth redirects and sitemap)
# Local: http://localhost:3001
# Production: https://your-domain.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google Analytics 4
# Get from: https://analytics.google.com > Admin > Data Streams > Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
