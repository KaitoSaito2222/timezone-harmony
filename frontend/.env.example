# ============================================================
# Next.js Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Supabase Configuration
# Get these from: https://app.supabase.com/project/YOUR-PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Site URL (used for OAuth redirects and sitemap)
# Local: http://localhost:3001
# Production: https://your-domain.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google Analytics 4
# Get from: https://analytics.google.com > Admin > Data Streams > Web
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
